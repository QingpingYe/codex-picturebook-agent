{
  "schema_version": 1,
  "entry_skill": "picturebook-screenwriter",
  "skills": [
    "picturebook-screenwriter",
    "text-craft",
    "craft-benchmark-check",
    "staging-planner",
    "wiki-ingest",
    "feishu-knowledge-store",
    "knowledge-loader",
    "lexile-check",
    "story-planning",
    "pre_create-baseline",
    "in_create-baseline",
    "post_create-baseline",
    "pre_output-baseline",
    "quality-baseline",
    "image-prompt-architect",
    "image-generate",
    "illustration-export",
    "session-export"
  ],
  "intents": [
    "creation",
    "revision",
    "review",
    "knowledge",
    "illustration"
  ],
  "artifact_types": [
    "positioning",
    "topic_plan",
    "worldview",
    "characters",
    "outline",
    "script",
    "illustration_prompt_payload",
    "image_asset",
    "asset_registry",
    "html_preview"
  ],
  "workflow_states": [
    "briefing",
    "knowledge_loading",
    "drafting",
    "self_review",
    "quality_review",
    "confirmation",
    "approved",
    "exported",
    "rejected"
  ],
  "creative_pipeline": {
    "resolver": "skills/picturebook-screenwriter/scripts/slot_resolver.py",
    "slots": [
      "pre_create",
      "in_create",
      "post_create",
      "pre_output",
      "quality"
    ],
    "default_tier": "baseline",
    "slot_skills": {
      "pre_create": "pre_create-baseline",
      "in_create": "in_create-baseline",
      "post_create": "post_create-baseline",
      "pre_output": "pre_output-baseline",
      "quality": "quality-baseline"
    },
    "lightweight_mode": {
      "skill": "story-planning",
      "trigger": "explicit_user_request",
      "write_policy": "dialog_only"
    }
  },
  "quality_gate": {
    "confirmation_package": [
      "draft",
      "metrics",
      "findings",
      "blocked_reasons"
    ],
    "project_authority": "FAIL_blocks_confirmation",
    "craft_benchmark": "FAIL_requires_user_confirmation",
    "wiki_lint": "read_only",
    "lexile_check": "optional_measured_only"
  },
  "illustration_route": {
    "sequence": [
      "staging-planner",
      "image-prompt-architect",
      "image-generate",
      "illustration-export"
    ],
    "confirmation_gate": "before_image_generation",
    "explicit_choices": [
      "output_directory",
      "size",
      "quality"
    ]
  },
  "image_generation": {
    "api_key_sources": [
      "explicit_cli_argument",
      "PICTUREBOOK_SFACAI_KEY"
    ],
    "key_logging": "forbidden",
    "default_api_call": "forbidden",
    "missing_references": "error"
  },
  "html_export": {
    "self_contained": true,
    "model_calls": "forbidden",
    "external_resources": "forbidden",
    "embed_required_args": [
      "limit_mb",
      "quality"
    ],
    "over_limit": "fail_closed"
  },
  "write_policy": {
    "default": "dialog_only",
    "allowed_write_triggers": [
      "user_approves_confirmation_gate",
      "user_explicitly_requests_export"
    ],
    "forbidden_write_triggers": [
      "workflow_finished",
      "quality_gate_passed",
      "cache_available",
      "plugin_maintenance"
    ]
  },
  "unsupported_workbuddy_capabilities": [
    "TeamCreate",
    "SendMessage",
    "native_workbuddy_hooks",
    "multi_subagent_team_runtime",
    "workbuddy_local_library"
  ]
}
